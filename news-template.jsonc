{
  // 每天新增一条新闻时，复制整段对象到 news-data.json 数组中（记得对象之间要用逗号分隔）
  "id": 999, // 必填：唯一整数 ID。请改成比现有最大 ID 更大的数字。
  "title": "", // 必填：新闻标题，尽量一句话说清核心变化。
  "category": "", // 必填：分类，例如「人工智能」「新能源」「金融」。
  "date": "YYYY-MM-DD", // 必填：日期，格式固定为 年-月-日，例如 2026-04-19。
  "is_featured": false, // 必填：是否置顶到首页核心机会。true=置顶，false=普通。
  "summary": "", // 必填：一句摘要，概括发生了什么。
  "opportunity": "", // 必填：机会研判，说明潜在受益方向。
  "content": "", // 必填：正文，可写背景、数据、推演逻辑。
  "source_name": "", // 必填：来源名称，例如「政策追踪」「公司公告」。
  "source_url": "", // 可留空：来源链接。留空时详情页会自动隐藏“打开来源链接”按钮。
  "risk": "", // 可留空：风险提示。留空时详情页会自动隐藏 risk 模块。
  "why_it_matters": "" // 可留空：为什么重要。留空时详情页会自动隐藏 why_it_matters 模块。
}
